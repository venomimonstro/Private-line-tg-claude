# Telegram
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username
ADMIN_CHAT_ID=123456789

# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./private_line.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://privateline:password@localhost/privateline
# POSTGRES_PASSWORD=changeme

# Шифрование (сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# Подпись сессий (сгенерировать: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here

# Приложение
APP_VERSION=1.0.0
BACKUP_DIR=./backups
APP_DIR=.
MAINTENANCE_MODE=false

# Сессия администратора
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# Платёжный провайдер (manual | yoomoney | freekassa | lava | yookassa | robokassa | prodamus | stars | crypto)
PAYMENT_PROVIDER=manual
WEBHOOK_BASE_URL=https://yourdomain.com

# Инструкции по оплате (отображаются пользователям при manual-провайдере)
PAYMENT_INSTRUCTIONS=Переведите сумму на карту Сбербанк: 0000 0000 0000 0000. В комментарии укажите ваш Telegram ID.

# Telegram Stars (курс: 1 звезда = 2 рубля, т.е. STARS_PER_RUB=0.5)
STARS_PER_RUB=0.5

# YooMoney
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=

# FreeKassa
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET_1=
FREEKASSA_SECRET_2=

# LAVA
LAVA_PROJECT_ID=
LAVA_SECRET_KEY=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Robokassa
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=

# Prodamus
PRODAMUS_API_URL=
PRODAMUS_WEBHOOK_SECRET=

# CryptoBot (t.me/CryptoBot)
CRYPTO_BOT_TOKEN=

# Необязательно: разрешённые IP для доступа к админке (пусто = все)
ADMIN_ALLOWED_IPS=

# Резервный бот для уведомлений (если основной заблокирован)
BACKUP_BOT_TOKEN=

# Кастомный Telegram API (для работы через прокси при блокировке)
# Например: https://your-proxy-server.com
TELEGRAM_API_URL=

# Настройки возврата средств
REFUND_WINDOW_DAYS=7
REFUND_MAX_TRAFFIC_MB=100.0

# Токен авто-регистрации VPN-нод (сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
# Используется скриптом install_node.sh для автоматической регистрации серверов
NODE_REGISTER_TOKEN=

# Monitoring
GRAFANA_PASSWORD=your_grafana_password_here
# Prometheus and Grafana run on ports 9090 and 3000 (localhost only by default)
