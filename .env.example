# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=123456789

# Database (SQLite для MVP; для PostgreSQL: postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///./private_line.db

# Шифрование (сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# Подпись сессий (сгенерировать: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here

# Приложение
APP_VERSION=1.0.0
BACKUP_DIR=./backups
APP_DIR=.

# Сессия администратора
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# Инструкции по оплате (отображаются пользователям)
PAYMENT_INSTRUCTIONS=Переведите сумму на карту Сбербанк: 0000 0000 0000 0000. В комментарии укажите ваш Telegram ID.

# Необязательно: разрешённые IP для доступа к админке (пусто = все)
ADMIN_ALLOWED_IPS=
