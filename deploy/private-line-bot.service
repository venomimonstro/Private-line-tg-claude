[Unit]
Description=Private Line Bot
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=privateline
WorkingDirectory=/opt/private-line
ExecStart=/opt/private-line/venv/bin/python bot/main.py
Restart=always
RestartSec=10
EnvironmentFile=/opt/private-line/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
